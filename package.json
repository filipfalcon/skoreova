{
  "name": "skoreova",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "applications/*",
    "libraries/domain/*",
    "libraries/foundation/*",
    "orchestrators/*",
    "services/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@effect/platform-node": "4.0.0-rc.116",
    "@foldkit/oxlint-plugin": "0.15.0",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "26.0.1",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.116",
    "effect-oxlint": "0.3.4",
    "typescript": "6.0.3",
    "vite-plus": "1.0.0-rc.0"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.116",
    "@effect/platform-node-shared": "4.0.0-rc.116",
    "@effect/sql-d1": "4.0.0-rc.116",
    "@effect/sql-sqlite-do": "4.0.0-rc.116",
    "@effect/vitest": "4.0.0-rc.116",
    "@oxlint/plugins": "1.79.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    }
  }
}
